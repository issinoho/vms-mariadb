# CMake options for Stage B: mariadbd with Aria, MyISAM, MyISAMMRG, MEMORY,
# CSV and SEQUENCE; no InnoDB (Stage C), no Galera, no big or external engines.
-DWITHOUT_SERVER=OFF
-DWITH_UNIT_TESTS=OFF
-DWITH_ZLIB=bundled
# PCRE2: "bundled" downloads it at build time and builds it with its own
# CMake, which the MMS build cannot follow; take it as a system library
# instead (headers from vms-pcre2 in the host sysroot, PCRE2$ROOT on the node).
-DWITH_PCRE=system
-DPCRE_INCLUDE_DIRS=@SYSROOT@/include/pcre2
-DWITH_WSREP=OFF
-DWITH_EMBEDDED_SERVER=OFF
-DCMAKE_BUILD_TYPE=RelWithDebInfo
# TLS: VSI SSL3 (D9), headers from the host sysroot; MMS links the images.
-DWITH_SSL=system
-DOPENSSL_INCLUDE_DIR=@SYSROOT@/include
-DOPENSSL_SSL_LIBRARY=@SYSROOT@/lib/libssl.so
-DOPENSSL_CRYPTO_LIBRARY=@SYSROOT@/lib/libcrypto.so
# Engines and plugins left out of Stage B.
-DPLUGIN_INNOBASE=NO
-DPLUGIN_ROCKSDB=NO
-DPLUGIN_MROONGA=NO
-DPLUGIN_SPIDER=NO
-DPLUGIN_CONNECT=NO
-DPLUGIN_COLUMNSTORE=NO
-DPLUGIN_OQGRAPH=NO
-DPLUGIN_SPHINX=NO
-DPLUGIN_S3=NO
-DPLUGIN_FEDERATED=NO
-DPLUGIN_FEDERATEDX=NO
-DPLUGIN_ARCHIVE=NO
-DPLUGIN_BLACKHOLE=NO
-DPLUGIN_PERFSCHEMA=NO
-DPLUGIN_AUTH_PAM=NO
-DPLUGIN_AUTH_PAM_V1=NO
-DPLUGIN_AUTH_GSSAPI=NO
-DPLUGIN_HASHICORP_KEY_MANAGEMENT=NO
-DPLUGIN_PROVIDER_BZIP2=NO
-DPLUGIN_PROVIDER_LZ4=NO
-DPLUGIN_PROVIDER_LZMA=NO
-DPLUGIN_PROVIDER_LZO=NO
-DPLUGIN_PROVIDER_SNAPPY=NO
-DPLUGIN_TYPE_MYSQL_JSON=NO
-DPLUGIN_DUCKDB=NO
# cmake/dtrace.cmake turns DTrace on when the host has a dtrace program (macOS
# does, in /usr/sbin); probes_mysql.h then wants probes_mysql_dtrace.h, which
# nothing generates for VMS.  VMS has no DTrace.
-DENABLE_DTRACE=OFF

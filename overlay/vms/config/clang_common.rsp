# clang options for every MariaDB compile on OpenVMS x86-64 (gen_mms.py puts
# these first in each response file, before CMake's -D/-I/-std; replay_gen.py
# applies the -D ones to every replayed check, so answers and build agree).
-O2
-g
# VSI's clang does not predefine __GNUC__ (upstream clang does, as 4.2.1, and
# -fgnuc-version is ignored).  MariaDB keys GCC/clang features on it
# (__builtin_bswap*, attributes, my_atomic.h): ~250 uses in 70 files.  The CRTL
# and libc++ headers behave the same with it (tested with the Phase 0 probes).
-D__GNUC__=4
-D__GNUC_MINOR__=2
-D__GNUC_PATCHLEVEL__=1
# main()'s argv is an array of 32-bit pointers by default, even with 64-bit
# pointers elsewhere, so passing &argv as char*** (load_defaults() and every
# client program) fails to compile.  This undocumented VSI clang option (the
# DCL CXX/POINTER_SIZE=LONG=ARGV) makes it 64-bit.
-pointer-size=argv64
# External names longer than 31 characters: VMS libraries built with VSI C,
# VSI SSL3 among them, export them in shortened form (a prefix plus a CRC);
# without this, SSL_CTX_use_certificate_chain_file and friends are undefined.
# It applies to C names; C++ calls into libc++ link and run unchanged
# (tested; docs/PORTING_LOG.md, Stage A round 4).
-names2=shortened
# VSI clang lowers memset() and bzero() to OTS$FILL but its optimiser still
# assumes the call returns its destination (as memset does), so
# "if ((p= alloc_root(...))) bzero(p, size); return p;" (THD::calloc,
# ma_calloc_root, new_ma_field_extension) became a tail call returning whatever
# OTS$FILL left in RAX: a pointer to some other block (found porting PHP,
# vms-php PORTING_LOG #17; reproduced in vms-php probes/r_calloc_shape.c;
# docs/PORTING_LOG.md here).  With these, explicit calls stay real C RTL
# calls (decc$_memset64, which returns its destination).
-fno-builtin-memset
-fno-builtin-bzero
# 64-bit 'long' in the C RTL interfaces (D12): strtol & co. and the printf and
# scanf families; see the header.  Relative to the top of the tree, where the
# build runs.
-include vms/include/vms_lp64.h
# VMS <pthread.h> includes STARLET's pthread_exception.h, which defines TRY,
# CATCH, CATCH_ALL, FINALLY, ENDTRY, RAISE, RERAISE and THIS_CATCH as macros
# (sql_cache.h: enum { WAIT, TIMEOUT, TRY }).  This keeps only the
# PTHREAD_*_NP names.
-D_PTHREAD_EXC_INCL_CLEAN

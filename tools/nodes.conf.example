# Copy to tools/nodes.conf (not committed) and adjust.
# sftp_workdir is relative to the sftp login directory, or absolute
# (/DISK$NAME/dir/sub) for a work directory on another disk.
# The work directory must be on an ODS-5 volume (MariaDB file names need EFS).
# name  arch    host          port  user      vms_workdir                         sftp_workdir
ia64    IA64    <ia64-host>   22    username  DISK$USER:[USERNAME.VMS_MARIADB]    vms_mariadb
x86     X86_64  <x86-host>    22    username  DISK$BUILD:[USERNAME.VMS_MARIADB]   /DISK$BUILD/username/vms_mariadb

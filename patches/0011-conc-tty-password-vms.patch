Subject: Connector/C: read passwords without echo on OpenVMS

get_tty_password() turns echo off with tcgetattr()/tcsetattr(), which the
OpenVMS C RTL does not have (link: undefined symbols). On VMS read the
password from SYS$COMMAND with a no-echo $QIOW instead, and from stdin when
there is no terminal.

--- a/libmariadb/libmariadb/get_password.c	2026-10-04 13:37:53.047168194 +0100
+++ b/libmariadb/libmariadb/get_password.c	2026-10-04 13:37:53.071079321 +0100
@@ -24,7 +24,11 @@
 #include <stdio.h>
 #include <memory.h>
 
-#ifndef _WIN32
+#if defined(__VMS)
+#include <descrip.h>
+#include <iodef.h>
+#include <starlet.h>
+#elif !defined(_WIN32)
 #include <termios.h>
 #else
 #include <conio.h>
@@ -140,6 +144,49 @@
   SetConsoleMode(Hdl, SaveState);
   CloseHandle(Hdl);
   return buffer;
+#elif defined(__VMS)
+  /*
+    No termios on OpenVMS: read the password from the terminal with a
+    no-echo QIO.  The QIO buffer is on the stack (32-bit address space),
+    which every terminal driver accepts.  Without a terminal (batch job,
+    pipe) read a line from stdin.
+  */
+  $DESCRIPTOR(tt, "SYS$COMMAND");
+  unsigned short chan;
+  struct { unsigned short status, count; unsigned int info; } iosb;
+  char tmp[256];
+  int sts;
+
+  memset(buffer, 0, length);
+  if (prompt)
+  {
+    fputs(prompt, stderr);
+    fflush(stderr);
+  }
+  sts= sys$assign(&tt, &chan, 0, 0);
+  if (sts & 1)
+  {
+    sts= sys$qiow(0, chan, IO$_READVBLK | IO$M_NOECHO, &iosb, 0, 0,
+                  tmp, sizeof(tmp) - 1, 0, 0, 0, 0);
+    if (sts & 1)
+      sts= iosb.status;
+    sys$dassgn(chan);
+    if (sts & 1)
+    {
+      size_t n= iosb.count < (size_t) length - 1 ? iosb.count : (size_t) length - 1;
+      memcpy(buffer, tmp, n);
+      buffer[n]= 0;
+      fputc('\n', stderr);
+      return buffer;
+    }
+  }
+  if (fgets(buffer, length, stdin))
+  {
+    size_t n= strlen(buffer);
+    while (n && (buffer[n - 1] == '\n' || buffer[n - 1] == '\r'))
+      buffer[--n]= 0;
+  }
+  return buffer;
 #else
   struct termios term_old, 
                  term_new;

Subject: mysys/my_lib.c: define _POSIX_PATH_MAX where <limits.h> does not

The OpenVMS C RTL's <limits.h> does not define _POSIX_PATH_MAX. Use the
POSIX value, 256, for the readdir_r buffer.

--- a/mysys/my_lib.c	2026-10-04 13:21:48.189510353 +0100
+++ b/mysys/my_lib.c	2026-10-04 13:21:48.206756221 +0100
@@ -117,6 +117,9 @@
   DIR		*dirp;
   struct dirent *dp;
   char		tmp_path[FN_REFLEN + 2], *tmp_file;
+#if defined(__VMS) && !defined(_POSIX_PATH_MAX)
+#define _POSIX_PATH_MAX 256   /* the POSIX minimum; not in the VMS <limits.h> */
+#endif
   char	dirent_tmp[sizeof(struct dirent)+_POSIX_PATH_MAX+1];
 
   DBUG_ENTER("my_dir");
